{
  "name": "@iam/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts up",
    "db:status": "tsx --env-file-if-exists=../../.env src/db/cli.ts status"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/pg": "^8.23.1"
  }
}
