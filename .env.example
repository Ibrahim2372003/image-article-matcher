NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/image_article_matcher
REDIS_URL=redis://localhost:6379
# mock | gemini | ollama
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
# Ollama: needs a vision model and an embedding model that natively outputs 768 dims
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Per AI call, milliseconds (1000-300000)
AI_TIMEOUT_MS=30000
# Required for mutating endpoints from milestone 5/6 onward (min 16 chars)
API_KEY=
MAX_UPLOAD_BYTES=5242880
# Database pool (bounded; defaults shown)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
# disable | require (use require for any non-local database)
DB_SSL=disable
# Mismatch Guard thresholds (optional; uncalibrated defaults are used when empty). See docs/policy.md
GUARD_MIN_CONFIDENCE=
GUARD_MIN_SIMILARITY=
GUARD_MIN_MARGIN=
GUARD_MIN_SHARED_TAGS=
# Optional: enables the real-database integration tests (use a scratch database)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/scratch_db

# --- Jobs / worker (milestone 5) ---
# Uploaded images are stored content-addressed here (gitignored).
IMAGE_STORAGE_DIR=./data/images
QUEUE_NAME=image-article-analysis
# Deadline for publishing to / inspecting the queue; BullMQ otherwise waits forever when Redis is down
QUEUE_PUBLISH_TIMEOUT_MS=3000
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=5000
JOB_BACKOFF_MAX_MS=300000
WORKER_CONCURRENCY=1
# How old an open job must be before the reconciler re-checks it
JOB_STALE_QUEUED_MS=60000
JOB_STALE_PROCESSING_MS=600000
JOB_RECONCILE_INTERVAL_MS=30000
# Must exceed the slowest job: up to 3 AI calls x AI_TIMEOUT_MS. Set docker stop_grace_period to at least this.
SHUTDOWN_TIMEOUT_MS=60000
# Per-client upload limit (in-memory, per API process)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Optional cost estimation. Unset = cost stays UNKNOWN (never zero). Example (rates per 1M tokens, YOUR values):
# AI_PRICING_JSON={"your-model-name":{"inputPer1M":0.0,"outputPer1M":0.0}}
AI_PRICING_JSON=
