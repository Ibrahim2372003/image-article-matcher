NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/image_article_matcher
REDIS_URL=redis://localhost:6379
# mock | gemini | ollama
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
# Required for mutating endpoints from milestone 5/6 onward (min 16 chars)
API_KEY=
MAX_UPLOAD_BYTES=5242880
# Database pool (bounded; defaults shown)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
# disable | require (use require for any non-local database)
DB_SSL=disable
